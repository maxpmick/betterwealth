[Unit]
Description=Create a BetterWealth SQLite backup
After=local-fs.target
ConditionPathExists=/opt/betterwealth/package.json
RequiresMountsFor=/opt/betterwealth/data /opt/betterwealth/backups

[Service]
Type=oneshot
User=betterwealth
Group=betterwealth
WorkingDirectory=/opt/betterwealth
EnvironmentFile=/etc/betterwealth.env
UnsetEnvironment=BOOTSTRAP_OPENROUTER_API_KEY BOOTSTRAP_SIMPLEFIN_SETUP_TOKEN BOOTSTRAP_USER_EMAIL BOOTSTRAP_USER_PASSWORD
ExecStart=/usr/local/bin/bun run ops:backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
SystemCallArchitectures=native
Nice=10
IOSchedulingClass=idle
ReadWritePaths=/opt/betterwealth/data /opt/betterwealth/backups
StandardOutput=journal
StandardError=journal
SyslogIdentifier=betterwealth-backup
