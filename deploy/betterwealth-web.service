[Unit]
Description=BetterWealth web application
After=network-online.target betterwealth-api.service
Wants=network-online.target betterwealth-api.service
StartLimitIntervalSec=5min
StartLimitBurst=5
ConditionPathExists=/opt/betterwealth/apps/web/dist/index.html

[Service]
Type=simple
User=betterwealth
Group=betterwealth
WorkingDirectory=/opt/betterwealth
ExecStart=/usr/local/bin/bun run start:web
ExecStartPost=/opt/betterwealth/deploy/healthcheck.sh --web-only
Restart=always
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
SystemCallArchitectures=native
TasksMax=128
LimitNOFILE=16384
StandardOutput=journal
StandardError=journal
SyslogIdentifier=betterwealth-web

[Install]
WantedBy=multi-user.target
