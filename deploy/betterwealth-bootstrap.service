[Unit]
Description=Bootstrap or reconcile the BetterWealth owner and integrations
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/betterwealth/package.json
RequiresMountsFor=/opt/betterwealth/data

[Service]
Type=oneshot
User=betterwealth
Group=betterwealth
WorkingDirectory=/opt/betterwealth
EnvironmentFile=/etc/betterwealth.env
ExecStartPre=/usr/local/bin/bun run db:migrate
ExecStart=/usr/local/bin/bun run bootstrap
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
SystemCallArchitectures=native
TasksMax=256
LimitNOFILE=65536
ReadWritePaths=/opt/betterwealth/data /opt/betterwealth/backups
StandardOutput=journal
StandardError=journal
SyslogIdentifier=betterwealth-bootstrap
