# Local development defaults. For production, follow docs/SELF_HOSTING.md and put
# the environment in root-owned /etc/betterwealth.env (mode 0600), not .env.local.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=./data/betterwealth.sqlite
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters
COOKIE_SECURE=false
TRUST_PROXY=false
# Keep registration closed for a personal deployment. Temporarily choose invite or
# open only when you intentionally want another household member to register.
REGISTRATION_MODE=closed
SESSION_IDLE_DAYS=14
SESSION_ABSOLUTE_DAYS=30
SYNC_INTERVAL_MINUTES=360
BACKUP_RETENTION_DAYS=30
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BOOTSTRAP_OPENROUTER_MODEL=tencent/hy3:free
# Bootstrap secrets are optional and should be cleared from the production env file
# immediately after bootstrap. The resulting provider credentials are encrypted in SQLite.
BOOTSTRAP_OPENROUTER_API_KEY=
BOOTSTRAP_SIMPLEFIN_SETUP_TOKEN=
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_HOUSEHOLD_NAME=My Wealth Plan
LOG_LEVEL=info
# This is compiled into the web build. Keep it same-origin behind the reverse proxy.
VITE_API_URL=/api/v1
